<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>

<BorderPane prefHeight="600.0" prefWidth="800.0" stylesheets="@gameBoardStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gamePanel.GameBoardController">

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <center>
      <GridPane fx:id="grid" hgap="0" vgap="0">
      </GridPane>
   </center>
   <bottom>
      <Button fx:id="rollDiceButton" mnemonicParsing="false" onAction="#rollDice" text="Roll Dice" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>

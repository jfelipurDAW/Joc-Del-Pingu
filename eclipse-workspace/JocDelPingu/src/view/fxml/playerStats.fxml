<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" alignment="CENTER" prefHeight="600.0" prefWidth="800.0" styleClass="mainmenu_bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ui.PlayerStatsController">
   <children>
      <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 40;">
         <children>
            <!-- Navigation Bar -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="nav-bar">
               <Button fx:id="backButton" onAction="#handleBack" styleClass="nav-btn-back" text="◀ Back" mnemonicParsing="false" />
            </HBox>

            <Text fx:id="titleText" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="mainmenu_maintitle" text="Player Statistics">
               <font>
                  <Font size="50.0" />
               </font>
            </Text>

            <!-- Stats header row -->
            <HBox fx:id="headerRow" alignment="CENTER" spacing="10" style="-fx-padding: 10; -fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 10;">
               <Label fx:id="headerPlayer" text="Player" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-min-width: 180;" />
               <Label fx:id="headerColour" text="Colour" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-min-width: 100;" />
               <Label fx:id="headerPlayed" text="Games Played" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-min-width: 140;" />
               <Label fx:id="headerWon" text="Games Won" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-min-width: 120;" />
            </HBox>

            <!-- Scrollable stats list -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="350.0" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent;">
               <content>
                  <VBox fx:id="statsContainer" alignment="TOP_CENTER" spacing="8" style="-fx-padding: 10;">
                  </VBox>
               </content>
            </ScrollPane>

            <!-- No data label (shown when empty) -->
            <Label fx:id="noDataLabel" text="No player data found." style="-fx-text-fill: white; -fx-font-size: 18;" visible="false" managed="false" />
         </children>
      </VBox>
   </children>
</StackPane>

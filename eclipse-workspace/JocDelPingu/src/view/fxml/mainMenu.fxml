<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" alignment="CENTER" prefHeight="507.0" prefWidth="758.0" styleClass="mainmenu_bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ui.MainMenuController">
   <children>
      <!-- HBox original (botons) -->
      <HBox alignment="CENTER" prefHeight="507.0" prefWidth="758.0">
         <children>
            <VBox alignment="CENTER" prefHeight="507.0" prefWidth="474.0" spacing="15">
               <children>
                  <StackPane>
                     <children>
                        <Text fx:id="titleShadowText" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="mainmenu_title_shadow" text="game.main.title" visible="true"></Text>
                        <Text fx:id="titleText" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="mainmenu_maintitle" text="game.main.title" visible="true"></Text>
                     </children>
                  </StackPane>
                  
                  <Button fx:id="newGame_button" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleNewGame" prefHeight="42.0" prefWidth="422.0" styleClass="mainmenu_button_newgame" text="new.game" textAlignment="CENTER" textFill="WHITE">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <VBox.margin>
                        <Insets top="80" />
                     </VBox.margin>
                  </Button>
                  
                  <Button fx:id="loadGame_button" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleLoadGame" prefHeight="42.0" prefWidth="422.0" styleClass="mainmenu_button_loadgame" text="load.game" textFill="WHITE">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  
                  <!-- Changed: replaced Button with ComboBox for language selection dropdown -->
                  <ComboBox fx:id="language_combobox" prefHeight="42.0" prefWidth="220.0" styleClass="mainmenu_language_combo">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </ComboBox>
               </children>
            </VBox>
         </children>
      </HBox>
      
      <!-- Aquí s'afegirà el text bitmap des del controlador -->
   </children>
</StackPane>

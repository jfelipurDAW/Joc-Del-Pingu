<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" alignment="CENTER" prefHeight="600.0" prefWidth="800.0" styleClass="mainmenu_bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ui.PlayerSetupController">
   <children>
      <VBox alignment="BOTTOM_CENTER" spacing="20" styleClass="glass-pane" style="-fx-padding: 40;">
         <children>
            <Text fx:id="titleText" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="mainmenu_maintitle" text="">
               <font>
                  <Font size="40.0" />
               </font>
            </Text>

            <HBox alignment="CENTER" spacing="20">
               <Label fx:id="player_number_select" style="-fx-font-size: 14;" text="" />
               <ComboBox fx:id="numPlayersCombo" prefWidth="80.0" />
               <Label  fx:id="enable_seal_checkbox" style="-fx-font-size: 14;" text="" />
               <CheckBox fx:id="sealCheckBox" />
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="350.0" vbarPolicy="AS_NEEDED">
               <content>
                  <VBox fx:id="playersContainer" alignment="TOP_CENTER" spacing="15" style="-fx-padding: 10;">
                  </VBox>
               </content>
            </ScrollPane>

            <Button fx:id="startGameButton" onAction="#handleStartGame" prefHeight="50.0" prefWidth="250.0" styleClass="mainmenu_button_newgame" text="Start Game" />
         </children>
      </VBox>
   </children>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="420.0" prefWidth="640.0" spacing="6.0" style="-fx-background-color: #07101a;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ui.DebugConsoleController">
   <padding>
      <Insets top="8.0" right="10.0" bottom="8.0" left="10.0"/>
   </padding>
   <children>
      <TextArea fx:id="outputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
      <HBox spacing="6.0">
         <children>
            <TextField fx:id="inputField" promptText="/help" onAction="#handleInputEnter" HBox.hgrow="ALWAYS"/>
            <Button fx:id="sendButton" text="Send" onAction="#handleSend"/>
         </children>
      </HBox>
   </children>
</VBox>
